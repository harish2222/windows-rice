{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "firecrawl": {
      "type": "remote",
      "url": "https://mcp.firecrawl.dev/fc-9380bcb926764541a9eafa97a3bf98be/v2/mcp",
      "enabled": true
    },
    "agentdb": {
      "type": "local",
      "command": ["cmd.exe", "/d", "/c", "npx", "-y", "agentdb@latest", "mcp", "start"],
      "enabled": true
    },
    "claude-flow": {
      "type": "local",
      "command": ["cmd.exe", "/d", "/c", "npx", "-y", "claude-flow@3.61.1", "mcp", "start"],
      "enabled": true
    },
    "caveman": {
      "type": "local",
      "command": ["cmd.exe", "/d", "/c", "C:\\Users\\haris\\.caveman\\bin\\caveman-mcp.exe"],
      "enabled": true
    },
    "rea": {
      "type": "local",
      "command": [
        "cmd.exe",
        "/d",
        "/c",
        "npx",
        "-y",
        "rea-agents@6.7.0",
        "mcp"
      ],
      "enabled": true
    }
  }
}
