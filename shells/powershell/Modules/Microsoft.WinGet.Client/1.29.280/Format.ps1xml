              </TableColumnItem>
              <TableColumnItem>
                <ScriptBlock>$_.CorrelationData</ScriptBlock>
              </TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
