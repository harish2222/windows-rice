$script:IsWindowsCheck = ($PSVersionTable.PSVersion.Major -le 5) -or $IsWindows

if ($AnsiCompatible -or -not $script:IsWindowsCheck) {
    $script:filesString = '📁 Files'
    $script:hashesString = '🍡 Hashes'
