		[switch]$NoMouse,
		[string[]]$Bind,
		[switch]$Cycle,
		[switch]$KeepRight,
		[switch]$NoHScroll,
		[switch]$FilepathWord,

		# Layout
		[ValidatePattern("^[1-9]+[0-9]+$|^[1-9][0-9]?%?$|^100%?$")]
