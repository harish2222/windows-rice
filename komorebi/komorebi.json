{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/master/schema.json",
  "animation": {
    "style": "EaseOutBack",
    "fps": 60,
    "enabled": true,
    "duration": 200,
    "ghost_movement": true
  },
  "border": true,
  "border_colours": {
    "monocle": "#D8A854",
    "stack": "#BE8FD8",
    "unfocused": "#4A2E38",
    "single": "#C04E68",
    "float": "#D8A854"
  },
  "border_implementation": "Windows",
  "border_offset": 0,
  "border_style": "System",
  "border_width": 2,
  "cross_monitor_move_behaviour": "Swap",
  "default_container_padding": 0,
  "default_workspace_padding": 1,
  "float_override": false,
  "floating_layer_behaviour": "Float",
  "float_rule_placement": "Center",
  "floating_layer_placement": "Center",
  "global_work_area_offset": {
    "bottom": 0,
    "right": 0,
    "top": 0,
    "left": 0
  },
  "mouse_follows_focus": false,
  "stackbar": {
    "height": 0,
    "mode": "Always",
    "label": "Process",
    "tabs": {
      "background": "#ffffff",
      "width": 0,
      "focused_text": "#ffffff",
      "unfocused_text": "#ffffff",
      "font_size": 0,
      "font_family": "Segoe UI"
    }
  },
  "transparency": false,
  "transparency_alpha": 220,
  "app_specific_configuration_path": "C:\\Users\\haris\\.config\\komorebi\\applications.json",
  "unmanaged_window_operation_behaviour": "Op",
  "window_container_behaviour": "Create",
  "window_hiding_behaviour": "Cloak",
