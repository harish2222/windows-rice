local wez = require 'wezterm'
local act = wez.action
local config = wez.config_builder()

-- ═══════════════════════════════════════════════════════════════════════════
-- FONT — CaskaydiaCove Nerd Font (primary), Mononoki Nerd Font (fallback)
-- ═══════════════════════════════════════════════════════════════════════════
config.font = wez.font_with_fallback {
    { family = 'CaskaydiaCove Nerd Font', weight = 'Medium' },
    { family = 'Mononoki Nerd Font', weight = 'Medium' },
}
config.font_size = 11.0
config.line_height = 1.0
config.cell_width = 1.0
config.freetype_load_flags = 'NO_HINTING'
config.freetype_load_target = 'HorizontalLcd'
config.freetype_render_target = 'HorizontalLcd'

-- ═══════════════════════════════════════════════════════════════════════════
-- GPU / 3D RENDERING — WebGpu (Direct3D 11), same as Windows Terminal
-- ═══════════════════════════════════════════════════════════════════════════
config.front_end = 'WebGpu'
config.webgpu_power_preference = 'HighPerformance'
config.max_fps = 120
config.animation_fps = 120
config.cursor_blink_rate = 500
config.cursor_blink_ease_in = 'Constant'
config.cursor_blink_ease_out = 'Constant'

-- ═══════════════════════════════════════════════════════════════════════════
