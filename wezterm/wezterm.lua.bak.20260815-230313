config.window_padding = {
    left = 8,
    right = 8,
    top = 4,
    bottom = 0,
}
config.window_decorations = 'TITLE|RESIZE'
config.window_frame = {
    font = wez.font('CaskaydiaCove Nerd Font', { weight = 'Bold' }),
    font_size = 10.0,
    active_titlebar_bg = '#1e1e2e',
    inactive_titlebar_bg = '#181825',
    inactive_titlebar_fg = '#6c7086',
    active_titlebar_fg = '#cdd6f4',
    inactive_titlebar_border_bottom = '#313244',
    active_titlebar_border_bottom = '#45475a',
    button_fg = '#cdd6f4',
    button_bg = '#313244',
    button_hover_bg = '#45475a',
    button_hover_fg = '#cdd6f4',
}
config.initial_rows = 30
config.initial_cols = 120
config.default_cursor_style = 'BlinkingBar'
config.hide_tab_bar_if_only_one_tab = true
config.use_fancy_tab_bar = false
config.tab_bar_at_bottom = false
config.show_tab_index_in_tab_bar = false
config.inactive_pane_hsb = { saturation = 0.9, brightness = 0.8 }
config.audible_bell = 'Disabled'
config.window_close_confirmation = 'NeverPrompt'
config.adjust_window_size_when_changing_font_size = false
config.show_new_tab_button_in_tab_bar = false
config.hide_mouse_cursor_when_typing = true

-- ═══════════════════════════════════════════════════════════════════════════
