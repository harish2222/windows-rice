-- ═══════════════════════════════════════════════════════════════════════════
-- SSH / MULTIPLEXER
-- ═══════════════════════════════════════════════════════════════════════════
config.ssh_domains = wez.default_ssh_domains()
config.unix_domains = {
    { name = 'unix', skip_unicode_verification = true },
}

-- ═══════════════════════════════════════════════════════════════════════════
-- STATUS BAR
-- ═══════════════════════════════════════════════════════════════════════════
wez.on('update-right-status', function(window, pane)
    local cells = {}
    local cwd_uri = pane:get_working_directory()
    if cwd_uri then
        local cwd = cwd_uri.file_path or cwd_uri
        table.insert(cells, { Text = wez.nerdfonts.md_folder .. ' ' .. cwd })
    end
    local username = os.getenv('USERNAME') or 'user'
    table.insert(cells, { Text = wez.nerdfonts.md_account .. ' ' .. username })
    window:set_right_status(wez.format(cells))
end)

wez.on('format-tab-title', function(tab, _, _, _, _, max_width)
    local index = tab.tab_index + 1
    local title = tab.active_pane.title or 'shell'
    return string.format(' %s %s ', wez.nerdfonts.md_tab .. tostring(index), title)
end)

-- ═══════════════════════════════════════════════════════════════════════════
-- MISC
-- ═══════════════════════════════════════════════════════════════════════════
config.check_for_updates = false
config.enable_ssh_agent = true

return config
