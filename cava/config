# ═══════════════════════════════════════════════════════════════════
#  cava — riced for the MPD sessions (Tokyo Night gradient)
#  On Windows cava automatically captures whatever the system is
#  playing (WASAPI loopback): MPD, cliamp, browsers — everything.
# ═══════════════════════════════════════════════════════════════════

[general]

# reload automatically when this file changes
live-config = 1
framerate = 60
autosens = 1
sensitivity = 100

# 0 = fill the terminal width
bars = 0
bar_width = 2
bar_spacing = 1
center_align = 1
max_height = 100
lower_cutoff_freq = 50
higher_cutoff_freq = 12000

# never fall asleep
sleep_timer = 0

[input]

# Windows: input is automatic (system loopback).
# Do NOT uncomment `method` here — this build rejects it.

[output]

method = noncurses
orientation = bottom
channels = stereo
xaxis = none
show_idle_bar_heads = 1

[color]

# transparent background = inherits your terminal's rice
background = default
foreground = '#CE4152'

# Rewritten by `yasb-theme set|next|prev` so the visualiser follows the bar.
# Stops run bottom (bass) → top (treble); only the values below are touched.
gradient = 1
gradient_color_1 = '#CE4152'
gradient_color_2 = '#E25050'
gradient_color_3 = '#E2905E'
gradient_color_4 = '#CEA854'
gradient_color_5 = '#90AC60'
gradient_color_6 = '#5EA698'
gradient_color_7 = '#64A0B2'
gradient_color_8 = '#8CC4CE'

[smoothing]

# monstercat bars with waves — the classic riced look
monstercat = 1
waves = 1
noise_reduction = 80

[eq]

; 1 = 1
; 2 = 1
; 3 = 1
; 4 = 1
; 5 = 1
