{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/master/schema.json",
  "app_specific_configuration_path": "C:\\Users\\haris\\.config\\komorebi\\applications.json",
  "animation": {
    "enabled": true,
    "fps": 144,
    "duration": 150,
    "style": "EaseOutExpo",
    "ghost_movement": false
  },
  "border": true,
  "border_colours": {
    "monocle": "#D8A854",
    "stack": "#BE8FD8",
    "unfocused": "#4A2E38",
    "single": "#C04E68",
    "float": "#D8A854"
  },
  "border_implementation": "Windows",
  "border_offset": 0,
  "border_style": "System",
  "border_width": 2,
  "cross_monitor_move_behaviour": "Insert",
  "default_container_padding": 0,
  "default_workspace_padding": 1,
  "float_override": true,
  "floating_layer_behaviour": "Float",
  "float_rule_placement": "Center",
