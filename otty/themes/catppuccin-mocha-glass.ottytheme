[meta]
name        = "Catppuccin Mocha Glass"
author      = "HKDEVS"
mode        = "dark"
description = "Catppuccin Mocha palette on a Windows 11 acrylic surface (frosted glass)."

[terminal]
foreground           = "#CDD6F4"
background           = "#1E1E2E"
palette = [
    "#45475A", "#F38BA8", "#A6E3A1", "#F9E2AF",
    "#89B4FA", "#F5C2E7", "#94E2D5", "#BAC2DE",
    "#585B70", "#F38BA8", "#A6E3A1", "#F9E2AF",
    "#89B4FA", "#F5C2E7", "#94E2D5", "#A6ADC8",
]
cursor               = "#F5E0DC"
selection-background = "#F5E0DC"

[token]
foreground = "#CDD6F4"
secondary  = "#BAC2DE"
tertiary   = "#A6ADC8"
accent     = "#89B4FA"
success    = "#A6E3A1"
warning    = "#F9E2AF"
danger     = "#F38BA8"
hover-bg   = "rgba(205,214,244,0.06)"
active-bg  = "rgba(205,214,244,0.10)"
radius     = 4
shadow     = "0 8px 16px rgba(0,0,0,0.28)"
font-ui    = ["Segoe UI Variable Text", "Segoe UI", "sans-serif"]
font-mono  = ["CaskaydiaCove Nerd Font Mono", "Cascadia Mono", "Cascadia Code", "Consolas", "monospace"]
font-size  = 13

[panel]
background = "#181825"
surface    = "#1E1E2E"
border     = "#313244"

# ── Windows acrylic ─────────────────────────────────────────────────────────
# `acrylic-thin` on the window frame and `acrylic` on the chrome columns.
# The earlier `material = "acrylic"` on the whole window crashed the XAML
# compositor on this build; the thin variant is what Otty's own Acrylic Dark
# theme uses and it keeps the terminal grid on an opaque plate.
[windows]
material = "acrylic-thin"
color    = "#181825"
opacity  = 0.85

[windows.sidebar]
material = "acrylic"
color    = "#181825"
opacity  = 0.8

[sidebar]
border-right = "none"

[details-panel]
border-right = "none"

[titlebar]
foreground = "#CDD6F4"

[tab]
radius          = 4
foreground      = "#A6ADC8"
font-weight     = 400
indicator       = "bar"
indicator-color = "#89B4FA"

[tab.active]
background  = "#CDD6F417"
foreground  = "#CDD6F4"
border      = "1px solid #CDD6F414"
font-weight = 600

[tab.hover]
background  = "#CDD6F40F"

[container]
background = "#1E1E2E"
shadow     = "0 1.5px 6px rgba(0,0,0,0.18)"
