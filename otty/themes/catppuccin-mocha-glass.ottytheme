# ============================================================================
# Author -: HKDEVS
# Project -: Window-Rice
# Title -: Otty Terminal Theme (catppuccin-mocha-glass)
# ============================================================================
[meta]
name        = "Catppuccin Mocha Glass"
author      = "HKDEVS"
mode        = "dark"
description = "Catppuccin Mocha palette on a Windows 11 acrylic surface (frosted glass)."

[terminal]
foreground           = "#CDD6F4"
background           = "#1E1E2E"
palette = [
    "#45475A", "#F38BA8", "#A6E3A1", "#F9E2AF",
    "#89B4FA", "#F5C2E7", "#94E2D5", "#BAC2DE",
    "#585B70", "#F38BA8", "#A6E3A1", "#F9E2AF",
    "#89B4FA", "#F5C2E7", "#94E2D5", "#A6ADC8",
]
cursor               = "#F5E0DC"
selection-background = "#F5E0DC"

[token]
foreground = "#CDD6F4"
secondary  = "#BAC2DE"
tertiary   = "#A6ADC8"
accent     = "#89B4FA"
success    = "#A6E3A1"
warning    = "#F9E2AF"
danger     = "#F38BA8"
hover-bg   = "rgba(205,214,244,0.06)"
active-bg  = "rgba(205,214,244,0.10)"
radius     = 4
shadow     = "0 8px 16px rgba(0,0,0,0.28)"
font-ui    = ["Segoe UI Variable Text", "Segoe UI", "sans-serif"]
font-mono  = ["Agave Nerd Font Mono", "Agave Nerd Font", "monospace"]
font-size = 15

[panel]
background = "#181825"
surface    = "#1E1E2E"
border     = "#313244"

[window]
material   = "glass"
background = "#1E1E2E"
opacity    = 0.92
radius     = 8

# ── Windows acrylic ─────────────────────────────────────────────────────────
# Neutral dark acrylic frosted glass matching Windows Terminal Catppuccin Mocha.
# Heavy blur with deep #1E1E2E base prevents desktop wallpaper color bleed.
[windows]
material = "acrylic-thin"
color    = "#1E1E2E"
opacity  = 0.95

[windows.sidebar]
material = "acrylic"
color    = "#181825"
opacity  = 0.95

[sidebar]
border-right = "none"

[details-panel]
border-right = "none"

[titlebar]
foreground = "#CDD6F4"

[tab]
radius          = 4
foreground      = "#A6ADC8"
font-weight     = 400
indicator       = "bar"
indicator-color = "#89B4FA"

[tab.active]
background  = "#CDD6F417"
foreground  = "#CDD6F4"
border      = "1px solid #CDD6F414"
font-weight = 600

[tab.hover]
background  = "#CDD6F40F"

[container]
background = "#1E1E2E"
shadow     = "0 1.5px 6px rgba(0,0,0,0.18)"
padding    = 8
