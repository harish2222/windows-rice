# ===== Never commit: secrets & personal data =====
manicode/
higgsfield/
containers/podman/
opencode/opencode.json
.android/

# ===== Nested independent git repos (they keep their own history) =====
emacs/
nushell/
powershell/

# ===== Binaries, build output, compiled tool assets =====
*.exe
*.dll
*.pyd
*.pdb
*.so
target/
build/
dist/
__pycache__/
rzodo/bin/
yasb/tools/picker/

# ===== Dependencies =====
node_modules/

# ===== Logs & runtime state =====
*.log
*.log.[0-9]
*.db
*.lock
# Rust lockfiles are part of the source of truth for the bar tools
!yasb/tools/saka/Cargo.lock
!yasb/tools/saka-popup/Cargo.lock
!yasb/tools/pomodoro/Cargo.lock
!yasb/tools/theme/yasb-theme/Cargo.lock
# The picker's Python source and PyInstaller artifacts are NOT tracked (they
# are a superseded fallback and pull in a large binary). The Rust crate IS the
# tool now, so its sources are tracked; target/ stays ignored via the rule
# above.
!yasb/tools/picker/
yasb/tools/picker/*
!yasb/tools/picker/picker.md
!yasb/tools/picker/palette-themes.json
!yasb/tools/picker/palette-picker/
yasb/tools/picker/palette-picker/*
!yasb/tools/picker/palette-picker/Cargo.toml
!yasb/tools/picker/palette-picker/Cargo.lock
!yasb/tools/picker/palette-picker/src/
!yasb/tools/picker/palette-picker/src/*.rs
!yasb/tools/picker/palette-picker/capture-screen.py
!yasb/tools/picker/palette-picker/capture-window.py
*.tmp
Thumbs.db
desktop.ini
cagent/user-uuid
# pomodoro runtime state (timer survives reloads; not config)
yasb/tools/pomodoro/pomodoro-state.txt
