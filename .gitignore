# ============================================================================
# Author -: HKDEVS
# Project -: Window-Rice
# Title -: Git Ignore Rules
# ============================================================================
# ===== Never commit: secrets & personal data =====
# Live desktop master files (HKDEVS): scoop/config.json contains a real API
# key slot (security review ed156b73: APS-001) and glazewm/config.yaml is the
# user's live master. Shipped rice continuity: glazewm/config.template.yaml
# (tracked canonical) + install.ps1 post-TUI deploy step to .glzr\glazewm.
scoop/config.json
glazewm/config.yaml
forgum/
nvim/
neovim/
rammap/
RAMMap/
configstore/
freebuff-desktop/
kilo/
opencode/
komorebi/backups/
yasb/assets/raw-art/
manicode/
higgsfield/
containers/podman/
.android/

# ===== Nested independent git repos (they keep their own history) =====
/emacs/
/nushell/
/powershell/

# ===== Binaries, build output, compiled tool assets =====
*.exe
# Binaries are NOT tracked: releases ship CI-built, SHA256SUMS-verified assets.
# (untracked per v1.0.4 security review run b3fff0fe: tracked exes drift vs
# source and their binary diffs break diff-based tooling)
*.dll
*.pyd
*.pdb
*.so
target/
yasb/target/
build/
dist/
__pycache__/
rzodo/bin/
yasb/tools/picker/
*.bak*

# ===== Agent working directories and scratch =====
.agents/
agents/
ORIGINAL_REQUEST.md

# ===== Local security-mcp state (review artifacts are committed explicitly) =====
.mcp/audit/
.mcp/agent-clis/
.mcp/agent-runs/
.mcp/memory/

# ===== Dependencies =====
node_modules/

# ===== Logs & runtime state =====
cliamp/*.sock*
cliamp/*.log*
cliamp/history.toml
*.log
*.log.[0-9]
*.db
*.lock
# Rust lockfiles are part of the source of truth for the bar tools
!yasb/tools/saka/Cargo.lock
!yasb/tools/saka-popup/Cargo.lock
!yasb/tools/pomodoro/Cargo.lock
!yasb/tools/theme/yasb-theme/Cargo.lock
!yasb/tools/keybind/Cargo.lock
!installer/Cargo.lock
# term-launch crate: the launcher behind alt+return; its lockfile is source of
# truth so fresh clones rebuild byte-stable; binaries install from the
# SHA256SUMS-verified release assets instead of tracked blobs.
!tools/term-launch/Cargo.lock
# The picker's Python source and PyInstaller artifacts are NOT tracked (they
# are a superseded fallback and pull in a large binary). The Rust crate IS the
# tool now, so its sources are tracked; target/ stays ignored via the rule
# above.
!yasb/tools/picker/
yasb/tools/picker/*
!yasb/tools/picker/picker.md
!yasb/tools/picker/palette-themes.json
!yasb/tools/picker/palette-picker/
yasb/tools/picker/palette-picker/*
!yasb/tools/picker/palette-picker/Cargo.toml
!yasb/tools/picker/palette-picker/Cargo.lock
!yasb/tools/picker/palette-picker/src/
!yasb/tools/picker/palette-picker/src/*.rs
!yasb/tools/picker/palette-picker/capture-screen.py
!yasb/tools/picker/palette-picker/capture-window.py
*.tmp
Thumbs.db
desktop.ini
cagent/user-uuid
# pomodoro runtime state (timer survives reloads; not config)
yasb/tools/pomodoro/pomodoro-state.txt
# saka-popup runtime state (survives restarts; not config)
yasb/saka-state.json
# Alarm schedule: written by the bar at runtime, and entirely personal (it is
# the user's own daily routine). Never belongs in a published repo.
yasb/alarms.json
# Otty re-seeds its vendored default themes into this dir on every launch (they
# are otty-managed state; custom themes live in backups only). Ignore the dir's
# contents rather than the dir itself, so our own theme can be whitelisted.
otty/themes/*
!otty/themes/clear.ottytheme
# Local staging dir for the Rangalipi theme submission (zip + screenshots).
# Never belongs in the dotfiles repo.
rangalipi/
