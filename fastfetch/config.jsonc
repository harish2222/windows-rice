{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "C:/Users/haris/.config/fastfetch/sharingan.txt",
        "color": {
            "1": "red",
            "2": "black"
        },
        "padding": {
            "top": 0,
            "left": 1,
            "right": 2
        }
    },
    "display": {
        "separator": " → ",
        "color": {
            "keys": "cyan"
        },
        "hideCursor": true
    },
    "modules": [
        "title",
        "separator",
        {
            "type": "os",
            "key": "  OS",
            "format": "{pretty-name}"
        },
        {
            "type": "custom",
            "key": " Host",
            "format": "HKDEVS"
        },
        {
            "type": "uptime",
            "key": "Up"
        },
        {
            "type": "packages",
            "key": "Pkgs",
            "format": "{choco} (choco), {scoop-user} (scoop)"
        },
        {
            "type": "shell",
            "key": "Sh"
        },
        {
            "type": "terminal",
            "key": "Term"
        },
        {
            "type": "cpu",
            "key": " CPU"
        },
        {
            "type": "gpu",
            "key": " GPU",
            "format": "{name}"
        },
        {
            "type": "memory",
            "key": "RAM"
        },
        {
            "type": "battery",
            "key": "Bat"
        },
        "break",
        "colors"
    ]
}
