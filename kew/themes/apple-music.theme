# =============================================================================
#  apple-music.theme  —  fixed-colour variant of the same design system
#
#  Album-color mode (kewrc colorMode=3) derives accents from the cover art.
#  Use this theme instead when you want a stable, non-reactive palette:
#
#      [colors]
#      theme=apple-music
#
#  or press `i` in kew until "Text colour" / theme mode cycles to it.
#
#  Tokens: charcoal-neutral structure, soft white primary, muted gray
#  secondary, one blue accent, warm salmon reserved for warnings/highlights.
# =============================================================================

name=Apple Music Dark

